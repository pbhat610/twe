# ── Required for live AI (without it the app runs in free offline demo mode) ──
OPENAI_API_KEY=

# LLM used for planning, answer analysis and the report (structured outputs)
# Which brain answers the AI tasks:
#   fixtures  = outputs Claude wrote for the demo data + offline rules (FREE, default)
#   openai    = real OpenAI calls (billed; the server log prints the cost of every call)
#   heuristic = offline rules only (FREE)
LLM_PROVIDER=fixtures
# Quality model: writes JDs, plans questions, writes reports (few calls per interview).
# gpt-6.1-sol = $2 / $10 per 1M tokens (in/out). Cheaper: gpt-6.1-terra ($1/$5).
OPENAI_MODEL=gpt-6.1-sol
# Fast model: analyses every answer (most calls). gpt-6.1-terra = $1 / $5. Cheapest: gpt-6-luna ($0.10/$0.50).
OPENAI_MODEL_FAST=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low

# Speech-to-text for the candidate's mic answers
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# ── Interviewer voice ──
# TTS_PROVIDER=elevenlabs (default, best voice) | openai (cheap) | none (free browser voice)
# Falls back to OpenAI TTS automatically if ELEVENLABS_API_KEY is empty.
TTS_PROVIDER=elevenlabs
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

ELEVENLABS_API_KEY=
# Default "Sarah" works on free plans. Library voices need a paid ElevenLabs plan.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# eleven_v4_turbo = most expressive real-time · eleven_v4 = highest quality (slower) · eleven_flash_v2_5 = cheapest
ELEVENLABS_MODEL=eleven_v4_turbo

# ── Avatar ──
# local = open-source in-browser avatar (TalkingHead 3D → 2D fallback), no account needed (default)
# simli = optional hosted photoreal face (free 50 min/month at simli.com), lip-syncs our TTS audio
AVATAR_PROVIDER=local
SIMLI_API_KEY=
SIMLI_FACE_ID=14c60d62-6ebf-424d-b626-1f4f91c33b04

# ── Database ──
# Supabase Postgres (required on Vercel; serverless instances don't share memory).
# Run supabase/setup.sql once in Supabase → SQL Editor (creates all tables + the recordings bucket).
# Leave empty for local dev to use in-memory storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:setup` (creates the tables). Supabase → Connect → Session pooler string, password filled in.
SUPABASE_DB_URL=
# Private Storage bucket for interview video (created by supabase/migrations/0003).
SUPABASE_RECORDINGS_BUCKET=interview-recordings

# ── Recruiter login ──
# Single recruiter account. Candidates never log in (they use their private link).
RECRUITER_EMAIL=
RECRUITER_PASSWORD=
# Random 32+ char secret used to sign the session cookie: `openssl rand -base64 32`
AUTH_SECRET=
